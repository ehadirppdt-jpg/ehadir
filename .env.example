# e-HADIR TUARAN — Environment Configuration

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Maps API Key for School & Geofence Visualizer
VITE_GOOGLE_MAPS_API_KEY=

# Application Mode
VITE_APP_NAME="e-HADIR TUARAN"
VITE_PPD_DISTRICT="Pejabat Pendidikan Daerah Tuaran"

# Fallback mode allows the app to function with full local persistent state
# if remote Supabase connection is not yet configured.
VITE_ENABLE_MOCK_FALLBACK=true
